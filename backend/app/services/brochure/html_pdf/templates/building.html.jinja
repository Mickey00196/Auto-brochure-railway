{% import "_macros.html.jinja" as m with context %}
<section class="page" data-page="building-{{ b.number }}">
  <div class="panel" style="left:688px;width:435px;"></div>
  {{ m.page_header("Office market inventory" + (" · " + city if city else "")) }}
  <div style="position:absolute;left:56px;top:80px;width:592px;height:380px;overflow:hidden;background:linear-gradient(135deg,#0F2557,#1D4ED8);">
    {% if b.photo %}
    <img src="{{ b.photo }}" alt="{{ b.name }}" onerror="this.style.display='none'" style="position:absolute;left:0;top:0;width:100%;height:100%;object-fit:cover;display:block;">
    {% endif %}
    <div class="pin" style="position:absolute;left:0;bottom:0;width:52px;height:52px;font-size:18px;">{{ "%02d"|format(b.number) }}</div>
  </div>
  <div style="position:absolute;left:56px;top:484px;width:592px;display:flex;flex-direction:column;">
    {% if b.submarket %}<div class="eyebrow">{{ b.submarket }}</div>{% endif %}
    <h1 style="margin:10px 0 0;font-size:36px;line-height:1.1;font-weight:300;letter-spacing:-0.02em;color:#16191D;">{{ b.name }}</h1>
    <div style="margin-top:6px;font-size:18px;font-weight:400;color:#3A3F45;">{{ b.address }}</div>
  </div>
  <div style="position:absolute;left:56px;top:612px;width:592px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #DCD8D1;">
    <div style="padding:16px 16px 0 0;display:flex;flex-direction:column;gap:6px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E4002B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11l1.6-4.2A2 2 0 0 1 8.5 5.5h7a2 2 0 0 1 1.9 1.3L19 11"></path><path d="M3.5 11h17v5.5h-17z"></path><path d="M6 16.5V19M18 16.5V19"></path><circle cx="7.5" cy="13.75" r="1"></circle><circle cx="16.5" cy="13.75" r="1"></circle></svg>
      <div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;">Road access</div>
      <div style="font-size:13px;line-height:1.45;color:#3A3F45;">{{ b.road_access }}</div>
    </div>
    <div style="padding:16px 16px 0;border-left:1px solid #DCD8D1;display:flex;flex-direction:column;gap:6px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E4002B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="3" width="12" height="14" rx="3"></rect><path d="M6 10h12"></path><circle cx="9.5" cy="13.5" r="1"></circle><circle cx="14.5" cy="13.5" r="1"></circle><path d="M8.5 21l2-4M15.5 21l-2-4"></path></svg>
      <div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;">Public transport</div>
      <div style="font-size:13px;line-height:1.45;color:#3A3F45;">{{ b.public_transport }}</div>
    </div>
    <div style="padding:16px 0 0 16px;border-left:1px solid #DCD8D1;display:flex;flex-direction:column;gap:6px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E4002B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15.5v-2l-7.5-4.5V4.5a1.5 1.5 0 0 0-3 0V9L3 13.5v2l7.5-2.25V18L8.5 19.5V21L12 20l3.5 1v-1.5L13.5 18v-4.75z"></path></svg>
      <div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;">Airport</div>
      <div style="font-size:13px;line-height:1.45;color:#3A3F45;">{{ b.airport }}</div>
    </div>
  </div>
  <div style="position:absolute;left:728px;top:92px;width:339px;display:flex;flex-direction:column;">
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding-top:14px;border-top:2px solid #16191D;">
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div style="font-size:12px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#5E636B;">Available</div>
        <div style="font-size:28px;font-weight:300;line-height:1.1;letter-spacing:-0.01em;">{{ b.available_value }}</div>
        <div style="font-size:12px;color:#5E636B;">{{ b.available_unit }}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div style="font-size:12px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#5E636B;">Office rent</div>
        <div style="font-size:28px;font-weight:300;line-height:1.1;letter-spacing:-0.01em;">{{ b.rent_value }}</div>
        <div style="font-size:12px;color:#5E636B;">{{ b.rent_unit }}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div style="font-size:12px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#5E636B;">Energy</div>
        <div style="font-size:28px;font-weight:300;line-height:1.1;letter-spacing:-0.01em;">{{ b.energy_label }}</div>
        <div style="font-size:12px;color:#5E636B;">energy label</div>
      </div>
    </div>
    <div class="section-label">Characteristics</div>
    {% for label, value in b.facts %}
    {{ m.fact_row(label, value) }}
    {% endfor %}
    {% if b.facilities %}
    <div class="section-label">Facilities</div>
    <div style="padding-top:10px;font-size:13px;line-height:1.5;color:#3A3F45;">{{ b.facilities }}</div>
    {% endif %}
  </div>
  <div style="position:absolute;left:56px;bottom:36px;font-size:12px;letter-spacing:0.08em;color:#5E636B;">{{ firm_name }}</div>
  <div style="position:absolute;left:728px;right:56px;bottom:36px;display:flex;justify-content:space-between;font-size:12px;letter-spacing:0.08em;color:#5E636B;">
    <span>All amounts excl. VAT</span>
    <span style="font-weight:600;color:#16191D;">{{ "%02d"|format(b.page) }}</span>
  </div>
</section>
