{% import "_macros.html.jinja" as m with context %}
<section class="page" data-page="locations-map">
  {{ m.page_header("Office market inventory" + (" · " + city if city else "")) }}
  <div style="position:absolute;left:56px;top:100px;width:600px;">
    {{ m.kicker_rule() }}
    <div class="eyebrow">02 &middot; Overview</div>
    <h2 class="display" style="font-size:32px;line-height:1.1;">{{ building_count }} location{{ "" if building_count == 1 else "s" }}</h2>
  </div>
  <div style="position:absolute;left:56px;top:216px;width:1011px;height:502px;background:#F4F2EE;border-radius:4px;overflow:hidden;">
    {% if map_image %}
    <img src="{{ map_image }}" alt="Map of all locations" style="width:100%;height:100%;object-fit:cover;display:block;">
    {% else %}
    <div style="padding:32px;display:flex;flex-wrap:wrap;gap:16px;align-content:flex-start;">
      {% for b in legend %}
      <div style="display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #DCD8D1;border-radius:999px;padding:8px 16px 8px 8px;">
        <span class="pin" style="width:26px;height:26px;border-radius:999px;font-size:11px;">{{ "%02d"|format(loop.index) }}</span>
        <span style="font-size:13px;font-weight:600;">{{ b.name }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {{ m.page_footer(5) }}
</section>
