{% import "_macros.html.jinja" as m with context %}
<section class="page" data-page="disclaimer" style="background:#F4F2EE;">
  <div style="position:absolute;left:0;top:0;width:1123px;height:6px;background:#E4002B;"></div>
  <img src="{{ logo_src }}" alt="Cushman &amp; Wakefield" style="position:absolute;left:56px;top:48px;height:32px;width:auto;">
  <div style="position:absolute;left:56px;top:130px;">
    {{ m.kicker_rule() }}
    <div class="eyebrow">Important information</div>
    <h2 class="display" style="font-size:36px;line-height:1.1;">Disclaimer</h2>
  </div>
  <div style="position:absolute;left:420px;top:180px;width:300px;font-size:13px;line-height:1.6;color:#3A3F45;">
    <p style="margin:0 0 16px;">This document has been prepared by {{ firm_name }} for {{ client_display_name }} and is confidential. It may not be shared with third parties without our prior written consent.</p>
    <p style="margin:0;">The information is based on data provided by owners, agents and other third parties. Although it has been compiled with care, {{ firm_name }} makes no representation or warranty, express or implied, as to its accuracy or completeness, and accepts no liability for any loss arising from its use.</p>
  </div>
  <div style="position:absolute;left:762px;top:180px;width:305px;font-size:13px;line-height:1.6;color:#3A3F45;">
    <p style="margin:0 0 16px;">All areas, rents, service charges and other figures are indicative, exclude VAT unless stated otherwise, and are subject to change, prior letting and contract. This document is not an offer and does not form part of any contract.</p>
    <p style="margin:0;">Maps and images are for illustration only. Map data &copy; OpenStreetMap contributors.</p>
  </div>
  <div style="position:absolute;left:56px;right:56px;bottom:36px;padding-top:20px;border-top:1px solid #DCD8D1;display:flex;justify-content:space-between;align-items:flex-end;">
    <div style="font-size:12px;line-height:1.6;color:#3A3F45;">
      <div style="font-weight:600;color:#16191D;">{{ firm_name }}</div>
      <div>{{ firm_address_line1 }} &middot; {{ firm_address_line2 }} &middot; {{ firm_phone }}</div>
      <div><a href="mailto:{{ firm_email }}">{{ firm_email }}</a></div>
    </div>
    <div style="font-size:12px;color:#5E636B;text-align:right;">
      <div>&copy; {{ year }} {{ firm_name }}</div>
      <div style="font-weight:600;color:#16191D;">{{ "%02d"|format(disclaimer_page) }}</div>
    </div>
  </div>
</section>
