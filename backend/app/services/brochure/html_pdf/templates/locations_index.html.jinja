{% import "_macros.html.jinja" as m with context %}
<section class="page" data-page="locations-index">
  {{ m.page_header("Office market inventory" + (" · " + city if city else "")) }}
  <div style="position:absolute;left:56px;top:100px;width:440px;display:flex;flex-direction:column;">
    {{ m.kicker_rule() }}
    <div class="eyebrow">Section 02</div>
    <h2 class="display" style="font-size:40px;line-height:1.1;">The locations</h2>
    <p class="lede">{{ building_count }} building{{ "" if building_count == 1 else "s" }}{% if city %} in and around {{ city }}{% endif %}, one page each, numbered as on the map on the next page.</p>
    <div style="margin-top:28px;border-top:1px solid #DCD8D1;">
      {% for b in buildings %}
      <div style="display:flex;align-items:baseline;gap:12px;padding:12px 0;border-bottom:1px solid #DCD8D1;font-size:14px;">
        <span style="color:#E4002B;font-weight:600;width:20px;">{{ "%02d"|format(loop.index) }}</span>
        <span style="flex:1;font-weight:600;">{{ b.name }}{% if b.submarket %} &middot; {{ b.submarket }}{% endif %}</span>
        <span style="color:#5E636B;">{{ "%02d"|format(b.page) }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  <div style="position:absolute;left:528px;top:0;width:595px;height:794px;display:grid;grid-template-columns:296px 295px;grid-template-rows:repeat({{ grid_rows }}, 1fr);gap:4px;background:#fff;">
    {% for b in buildings %}
    <div style="position:relative;overflow:hidden;background:linear-gradient(135deg,#0F2557,#1D4ED8);">
      {% if b.photo %}
      <img src="{{ b.photo }}" alt="{{ b.name }}" onerror="this.style.display='none'" style="width:100%;height:100%;object-fit:cover;display:block;">
      {% endif %}
      <span class="pin" style="position:absolute;left:0;bottom:0;width:32px;height:32px;font-size:12px;">{{ "%02d"|format(loop.index) }}</span>
    </div>
    {% endfor %}
    <a href="#" style="position:relative;display:flex;flex-direction:column;justify-content:center;padding:0 24px;background:#16191D;color:#fff;text-decoration:none;">
      <span style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#9CA0A6;">Overview map</span>
      <span style="margin-top:6px;font-size:24px;font-weight:300;">Page {{ "%02d"|format(locations_overview_page) }}</span>
    </a>
  </div>
  {{ m.page_footer(4) }}
</section>
