{% import "_macros.html.jinja" as m with context %}
<section class="page" data-page="requirements">
  <div class="panel panel-left" style="width:472px;"></div>
  {{ m.page_header("Office market inventory" + (" · " + city if city else "")) }}
  <div style="position:absolute;left:56px;top:100px;width:340px;display:flex;flex-direction:column;">
    {{ m.kicker_rule() }}
    <div class="eyebrow">01 &middot; The brief</div>
    <h2 class="display" style="font-size:40px;line-height:1.1;">Your requirements</h2>
    <p class="lede">The starting points for this search: size, timing, budget and the must-haves for {{ client_display_name }}.</p>
  </div>
  <div style="position:absolute;left:56px;top:560px;width:340px;padding-top:18px;border-top:1px solid #16191D;display:flex;flex-direction:column;gap:4px;font-size:14px;line-height:1.5;color:#3A3F45;">
    <div style="font-size:15px;font-weight:600;color:#16191D;">Used on page {{ occupancy_page }}</div>
    <div>The cost comparison is calculated on the required office area and the number of parking spaces on this page.</div>
  </div>
  <div style="position:absolute;left:520px;top:100px;width:547px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 32px;">
    {% for label, value in brief_fields %}
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:14px;border-top:1px solid #16191D;">
      <div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#5E636B;">{{ label }}</div>
      <div style="font-size:22px;font-weight:300;line-height:1.3;">{{ value|safe }}</div>
    </div>
    {% endfor %}
  </div>
  {% if must_haves %}
  <div style="position:absolute;left:520px;top:490px;width:547px;">
    <div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#5E636B;padding-top:14px;border-top:1px solid #16191D;">Must-haves</div>
    <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:8px;">
      {% for item in must_haves %}
      <span style="border:1px solid #DCD8D1;border-radius:999px;padding:6px 14px;font-size:13px;">{{ item }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {{ m.page_footer(3) }}
</section>
