{{ font_face_css }}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: 'Hanken Grotesk', 'Helvetica Neue', sans-serif;
  color: #16191D;
}

.page {
  width: 1123px;
  height: 794px;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  page-break-after: always;
}
.page:last-child { page-break-after: avoid; }

.panel { position: absolute; top: 0; height: 794px; background: #F4F2EE; }
.panel-left { left: 0; }

.eyebrow-top {
  position: absolute; left: 56px; top: 44px;
  font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
  color: #5E636B;
}
.logo-top { position: absolute; right: 56px; top: 38px; height: 26px; width: auto; display: block; }

.footer-row {
  position: absolute; left: 56px; right: 56px; bottom: 36px;
  display: flex; justify-content: space-between;
  font-size: 12px; letter-spacing: 0.08em; color: #5E636B;
}
.footer-row .page-number { font-weight: 600; color: #16191D; }

.kicker-rule { width: 40px; height: 2px; background: #E4002B; margin-bottom: 20px; }
.eyebrow {
  font-size: 13px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #E4002B;
}
h1.display, h2.display {
  margin: 14px 0 0; font-weight: 300; letter-spacing: -0.02em; color: #16191D;
}
.lede { margin-top: 20px; font-size: 15px; line-height: 1.6; color: #3A3F45; }

.ph { background: #FFF0B3; padding: 0 6px; }

.pin {
  background: #E4002B; color: #fff; display: flex; align-items: center; justify-content: center;
  font-weight: 500; letter-spacing: 0.04em;
}

.fact-row {
  display: grid; grid-template-columns: 136px minmax(0, 1fr); gap: 12px;
  padding: 4px 0; border-bottom: 1px solid #DCD8D1; font-size: 13px; line-height: 1.4;
}
.fact-label { color: #5E636B; }
.section-label {
  margin-top: 22px; padding-bottom: 8px; border-bottom: 1px solid #16191D;
  font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #E4002B;
}

a { color: #E4002B; text-decoration: none; }

@media print {
  @page { margin: 0; size: 1123px 794px; }
}
